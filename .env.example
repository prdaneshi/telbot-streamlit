# این فایل را به .env تغییر نام دهید و مقادیر خود را بگذارید
TELEGRAM_BOT_TOKEN=123456789:AAF...your-token-here

# برای Telethon (MTProto) از my.telegram.org بگیرید
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# اگر اینترنت شما به تلگرام دسترسی مستقیم ندارد، پروکسی بگذارید.
# هر سه فرمت پشتیبانی می‌شود:
# PROXY_URL=https://t.me/proxy?server=...&port=...&secret=...   (پروکسی MTProto)
# PROXY_URL=mtproto://server.com:8880/secret
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_URL=http://127.0.0.1:7890
# PROXY_URL=

