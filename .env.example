# این فایل را به .env تغییر نام دهید و توکن خود را بگذارید
# (یا از داخل پنل استریم‌لیت توکن را وارد و ذخیره کنید)
TELEGRAM_BOT_TOKEN=123456789:AAF...your-token-here

# اگر اینترنت شما به تلگرام دسترسی مستقیم ندارد، آدرس پروکسی را بگذارید.
# مثال‌ها (بسته به برنامه VPN شما — پورت را چک کنید):
# PROXY_URL=socks5://127.0.0.1:10808   (v2rayN / v2rayNG پیش‌فرض)
# PROXY_URL=socks5://127.0.0.1:1080    (Shadowsocks / کلش بعضی وقت‌ها)
# PROXY_URL=http://127.0.0.1:7890      (Clash)
# PROXY_URL=
